{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AegisSec Engagement",
  "type": "object",
  "required": [
    "engagement",
    "scope",
    "controls",
    "data_handling"
  ],
  "properties": {
    "engagement": {
      "type": "object",
      "required": [
        "id",
        "name",
        "owner",
        "requester",
        "authority_confirmed",
        "start",
        "end",
        "timezone"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "requester": {
          "type": "string"
        },
        "authority_confirmed": {
          "const": true
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "targets",
        "permitted_testing",
        "prohibited_actions"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1
        },
        "out_of_scope": {
          "type": "array"
        },
        "permitted_testing": {
          "type": "array",
          "minItems": 1
        },
        "prohibited_actions": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "controls": {
      "type": "object",
      "required": [
        "human_approval_required_for",
        "stop_conditions"
      ],
      "properties": {
        "max_requests_per_second": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "human_approval_required_for": {
          "type": "array"
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "data_handling": {
      "type": "object",
      "required": [
        "classification",
        "redact_personal_data"
      ],
      "properties": {
        "classification": {
          "type": "string"
        },
        "retention_days": {
          "type": "integer",
          "minimum": 0
        },
        "redact_personal_data": {
          "type": "boolean"
        }
      }
    }
  }
}
